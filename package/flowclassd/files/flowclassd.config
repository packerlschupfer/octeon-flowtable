config flowclassd 'settings'
	option enabled '1'
	# Daemon instances = NFQUEUE queues (0..n-1). Flows are spread by
	# address-pair hash, so both directions land in the same instance.
	# One per CPU core.
	option instances '2'
	# Give up and mark a flow (best guess) after this many queued packets.
	option max_packets '16'
	# Never queue a flow beyond this many packets (both directions). Keep it
	# <= firewall flow_offloading_gate_packets, the offload fallback.
	option queue_packets '24'
	# Log every classification to syslog (debug only).
	option verbose '0'
