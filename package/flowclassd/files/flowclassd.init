#!/bin/sh /etc/rc.common
# Start the nDPI flow classifier and its queue rule.
#
# table inet flowclassd hooks forward AFTER fw4 (priority filter + 10), so only
# packets fw4 accepted are queued and the zone rules are never bypassed by the
# NFQUEUE re-inject. Only flows without the classified bit and still within
# queue_packets packets are queued; the "bypass" flag accepts them if no daemon
# is listening. Offload gating itself is fw4's job (flow_offloading_gate).

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/flowclassd

load_rules() {
	local instances=$1 queue_packets=$2 qs=0

	[ "$instances" -gt 1 ] && qs="0-$((instances - 1))"
	nft -f - <<EOF
table inet flowclassd
delete table inet flowclassd
table inet flowclassd {
	chain forward {
		type filter hook forward priority filter + 10; policy accept;
		meta l4proto { tcp, udp } ct mark & 0x80000000 == 0 ct packets <= $queue_packets queue flags bypass to $qs
	}
}
EOF
}

start_service() {
	config_load flowclassd
	local enabled instances max_packets queue_packets verbose i
	config_get_bool enabled settings enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get instances settings instances 2
	config_get max_packets settings max_packets 16
	config_get queue_packets settings queue_packets 24
	config_get_bool verbose settings verbose 0

	modprobe nf_conntrack_netlink 2>/dev/null
	modprobe nfnetlink_queue 2>/dev/null
	modprobe nft_queue 2>/dev/null
	sysctl -q -w net.netfilter.nf_conntrack_acct=1

	[ "$(uci -q get firewall.@defaults[0].flow_offloading_gate)" = 1 ] || \
		logger -t flowclassd "note: firewall flow_offloading_gate is not '1' — flows are offloaded before classification completes"

	load_rules "$instances" "$queue_packets" || return 1

	i=0
	while [ "$i" -lt "$instances" ]; do
		procd_open_instance "q$i"
		procd_set_param command "$PROG" -q "$i" -n "$max_packets"
		[ "$verbose" = 1 ] && procd_append_param command -v
		procd_set_param respawn 3600 5 5
		procd_close_instance
		i=$((i + 1))
	done
}

service_stopped() {
	nft delete table inet flowclassd 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger flowclassd
}
