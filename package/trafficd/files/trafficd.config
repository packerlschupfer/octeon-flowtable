config trafficd 'settings'
	option enabled '1'
	# Conntrack dump interval in seconds (short connections are also caught
	# from DESTROY events, so this only bounds the resolution of long ones).
	option interval '30'
	# Device whose addresses are NOT LAN (default: network.wan.device).
	#option wan_device 'eth0'
	# Subnets or hosts never tracked per client (repeatable, IPv4 and IPv6).
	# Their bytes still count in the internet uplink total only.
	#list exclude '192.168.24.0/24'
